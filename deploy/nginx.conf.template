# CommonMailer API — nginx site.
#
# Written to /etc/nginx/conf.d/commonmailer.conf by deploy/setup-ec2.sh with
# __API_DOMAIN__ and __APP_PORT__ substituted. certbot rewrites this file when it
# installs the certificate, adding the 443 server block and the http->https
# redirect, so there is no TLS config here to go stale.

server {
    # IPv4 only, deliberately.
    #
    # If an IPv6 listener is declared here, certbot mirrors it as
    #   listen [::]:443 ssl ipv6only=on;
    # and `ipv6only` may be set only once per address:port for the whole nginx
    # config. On a server that already hosts other sites, whichever config
    # already owns that option makes ours fail with "duplicate listen options",
    # and nginx then refuses to load *any* config — taking every site down.
    #
    # Browsers reach an IPv4 API perfectly well. If this box is ever IPv6-only,
    # add the listener to exactly one config and remove it from the others.
    listen 80;
    server_name __API_DOMAIN__;

    # Keep the real client IP intact: the per-IP rate limit and the submission
    # log both read req.ip, and Express only trusts these because app.js sets
    # 'trust proxy'.
    location / {
        proxy_pass         http://127.0.0.1:__APP_PORT__;
        proxy_http_version 1.1;

        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        'upgrade';

        # CORS is decided per form inside the app (each form has its own list of
        # allowed websites), so nginx must not add its own CORS headers —
        # duplicates make browsers reject the response outright.

        proxy_connect_timeout 10s;
        proxy_send_timeout    30s;
        proxy_read_timeout    30s;
    }

    # Sized for the largest legitimate request: a campaign attachment of up to
    # 15 MB. Contact form posts stay tiny. The app enforces the real limit for
    # each endpoint — 1 MB for JSON, 5 MB for a recipient list, 15 MB of
    # attachments — so this value only has to let that largest one through.
    client_max_body_size 20m;

    # Do not advertise the nginx version.
    server_tokens off;

    access_log /var/log/nginx/commonmailer.access.log;
    error_log  /var/log/nginx/commonmailer.error.log;
}
