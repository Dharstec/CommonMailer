# ---------------------------------------------------------------------------
# CommonMailer backend
#
# Copy to .env on the server and fill in the marked values. .env is gitignored
# and must never be committed — it lives only on the machine it belongs to.
#
#   cp .env.example .env
#   nano .env
#
# Everything not listed here has a sensible default and is set automatically.
# The encryption and JWT keys are generated on first boot and saved to
# .secrets.json (also gitignored) — you do not create them by hand.
# ---------------------------------------------------------------------------

# --- YOU MUST SET THESE THREE ----------------------------------------------

# The database password you chose when running deploy/setup-ec2.sh
POSTGRESQL_PASSWORD=

# Public URL of THIS API, including https://
PUBLIC_BASE_URL=https://api.dharstec.com

# Where the admin panel is served from (your CloudFront URL, or a custom domain).
# Comma-separate if you have more than one.
FRONTEND_ORIGIN=https://d111111abcdef8.cloudfront.net

# --- OPTIONAL --------------------------------------------------------------

# Login email for the first admin account, created on first boot only.
# Its password is generated and written to FIRST_LOGIN.txt.
SEED_ADMIN_EMAIL=gokuldsp01@gmail.com
SEED_ADMIN_NAME=Gokul

# Set a specific first password instead of a generated one (not recommended).
# SEED_ADMIN_PASSWORD=

# --- AUTOMATIC — uncomment only to override --------------------------------
# PORT=4100
# NODE_ENV=production
# POSTGRESQL_HOST=localhost
# POSTGRESQL_PORT=5432
# POSTGRESQL_USER=commonmailer
# POSTGRESQL_DATABASE=common_mailer
# BACKEND_HOST=            # derived from PUBLIC_BASE_URL
# TOKEN_EXPIRY=8h
# SALT_ROUNDS=10
# PUBLIC_RATE_WINDOW_MINUTES=15
# PUBLIC_RATE_MAX=60
